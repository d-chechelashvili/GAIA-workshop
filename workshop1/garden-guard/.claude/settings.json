{
  "env": {
    "PLAY_WATCH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(node play.mjs:*)",
      "Bash(node --test:*)",
      "Bash(npm test)",
      "Bash(node doctor.mjs)",
      "Bash(git status:*)",
