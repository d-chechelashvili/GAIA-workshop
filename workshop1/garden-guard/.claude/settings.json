{
  "permissions": {
    "allow": [
      "Bash(node play.mjs:*)",
      "Bash(node --test:*)",
      "Bash(npm test)",
      "Bash(node doctor.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
